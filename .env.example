# Copy this file to ".env" in the SAME directory as WFM/ and test_sets/
#   copy .env.example .env
# Then put your real key in .env only. ".env" is gitignored and must never be committed.

ANTHROPIC_API_KEY=sk-ant-api03-replace-me

# Google Gemini (WFM runner: python test_sets/scripts/run_wfm_folio_gemini.py)
GEMINI_API_KEY=replace-with-your-google-ai-api-key

# Optional overrides (otherwise see test_sets/wfm_api_contract_frozen.md)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_TEMPERATURE=0
# ANTHROPIC_MAX_TOKENS=16384

# Optional Gemini overrides (see test_sets/wfm_api_contract_gemini.md)
# GEMINI_MODEL=gemini-3.1-pro-preview
# GEMINI_TEMPERATURE=0
# GEMINI_MAX_OUTPUT_TOKENS=16384
# GEMINI_THINKING_LEVEL=low
