# Copy this file to ".env" in the SAME directory as WFM/ and test_sets/
#   copy .env.example .env
# Then put your real key in .env only. ".env" is gitignored and must never be committed.

ANTHROPIC_API_KEY=sk-ant-api03-replace-me

# Google Gemini (WFM runner: python test_sets/scripts/run_wfm_folio_gemini.py)
GEMINI_API_KEY=replace-with-your-google-ai-api-key

# Optional overrides (otherwise see test_sets/wfm_api_contract_frozen.md)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_TEMPERATURE=0
# ANTHROPIC_MAX_TOKENS=16384

# Optional Gemini overrides (see test_sets/wfm_api_contract_gemini.md)
# GEMINI_MODEL=gemini-3.1-pro-preview
# GEMINI_TEMPERATURE=0
# GEMINI_MAX_OUTPUT_TOKENS=16384
# GEMINI_THINKING_LEVEL=low

# Pivot Test-Repairer / registry (see dev_plan_pivot_test_repairer_hardening_v1.md)
# PIVOT_TESTER_REPAIR_COMPILE_ATTEMPTS=5
# PIVOT_TESTER_REPAIR_REGISTRY_ATTEMPTS=3
# PIVOT_REGISTRY_JSON_REPAIR_MAX=3
# PIVOT_TEST_REPAIR_SKIP_REGISTRY=0
# PIVOT_TEST_REPAIR_COUNT_API_AS_ATTEMPT=0

# External world tester (dev_plan_external_world_tester_v1.md)
# PIVOT_EXTERNAL_FILL_GEMINI_MODEL=gemini-3.1-pro-preview
# PIVOT_EXTERNAL_REVIEW_GEMINI_MODEL=gemini-3.1-pro-preview
# PIVOT_EXTERNAL_SYNTAX_REPAIR_GEMINI_MODEL=gemini-3-flash-preview
# PIVOT_EXTERNAL_TESTER_API_AUTO_RETRIES=0
# PIVOT_EXTERNAL_FILL_MAX_ROUNDS=5
# PIVOT_EXTERNAL_REVIEW_MAX_ROUNDS=3
# PIVOT_EXTERNAL_SYNTAX_REPAIR_MAX=3
